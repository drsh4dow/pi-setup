#!/usr/bin/env bash
set -euo pipefail

TLA_VERSION=1.7.4
TLA_SHA256=936a262061c914694dfd669a543be24573c45d5aa0ff20a8b96b23d01e050e88
TLA_URL=https://github.com/tlaplus/tlaplus/releases/download/v$TLA_VERSION/tla2tools.jar
CACHE=${XDG_CACHE_HOME:-$HOME/.cache}/pi-setup
JAR=$CACHE/tla2tools-$TLA_VERSION.jar
JAVA=${JAVA:-java}

die() {
  echo "check: $*" >&2
  exit 2
}

definition_body() {
  awk -v name="$2" '
    function indent(text) {
      match(text, /^[ \t]*/)
      return RLENGTH
    }
    function is_comment(text) {
      return text ~ /^[ \t]*(\/\/|\/\*|\*)/
    }
    function opens_block_comment(text) {
      return text ~ /^[ \t]*\/\*/ && text !~ /\*\//
    }
    function opens_body(text) {
      if (name == "top-level") return text ~ /^[^ \t})\]]/ && text !~ declaration_keyword
      return text ~ keyword_declaration || text ~ member_declaration || text ~ tool || text ~ handler
    }
    function is_one_line(text) {
      return text ~ /;[ \t]*$/
    }
    function closes_definition(text) {
      if (text !~ /^[ \t]*[})\]]/ || text ~ /[{(\[][ \t]*$/) return 0
      if (tool_entry) return indent(text) < start_indent
      return indent(text) <= start_indent
    }
    BEGIN {
      word_end = "([^A-Za-z0-9_$]|$)"
      keyword_declaration = "^[ \t]*((export|default|declare|async)[ \t]+)*(const|let|var|class|function)[ \t*]+" name word_end
      modifiers = "((private|protected|public|static|readonly|async|get|set|override|abstract)[ \t]+)*"
      parameters_then_brace = "(<.*>)?[(].*[)]([ \t]*:[^=]*)?[ \t]*[{][ \t]*$"
      member_declaration = "^[ \t]*" modifiers name "[ \t]*(=([^=>]|$)|:|" parameters_then_brace ")"
      tool = "^[ \t]*name: \"" name "\""
      handler = "^[ \t]*pi\\.on\\(\"" name "\""
      declaration_keyword = "^(export|import|const|let|var|function|async|class|type|interface|enum|declare)" word_end
    }
    in_block_comment {
      if ($0 ~ /\*\//) in_block_comment = 0
      next
    }
    opens_block_comment($0) { in_block_comment = 1; next }
    is_comment($0) { next }
    inside && closes_definition($0) {
      inside = 0
      print
      next
    }
    inside { print; next }
    opens_body($0) {
      print
      if (is_one_line($0)) next
      inside = 1
      start_indent = indent($0)
      tool_entry = $0 ~ tool
      next
    }
  ' "$1"
}

check_citations() {
  local line path function snippet body stale=0
  local pattern='^\\\* code: ([^ ]+) ([^ ]+) "(.*)"$'

  while IFS= read -r line; do
    [[ $line == '\* code:'* ]] || continue

    if [[ ! $line =~ $pattern ]]; then
      echo "stale citation: malformed line, expected \\* code: <file> <function> \"<snippet>\": $line"
      stale=1
      continue
    fi

    path=${BASH_REMATCH[1]}
    function=${BASH_REMATCH[2]}
    snippet=${BASH_REMATCH[3]//\\\"/\"}

    if [[ ! -f $CHECKOUT/$path ]]; then
      echo "stale citation: $path does not exist"
      stale=1
    else
      body=$(definition_body "$CHECKOUT/$path" "$function")

      if [[ -z $body ]]; then
        echo "stale citation: $path has no definition of $function"
        stale=1
      elif ! grep -qF -- "$snippet" <<<"$body"; then
        echo "stale citation: $path $function no longer contains: $snippet"
        stale=1
      fi
    fi
  done <"$SKILL/$SPEC"

  return "$stale"
}

fetch_tlc() {
  local partial

  if [[ -f $JAR ]] && sha256sum --status -c <<<"$TLA_SHA256  $JAR"; then
    return
  fi

  mkdir -p "$CACHE"
  partial=$(mktemp "$CACHE/tla2tools.XXXXXX")
  curl -fsSL -o "$partial" "$TLA_URL" || {
    rm -f "$partial"
    die "could not download $TLA_URL"
  }

  if ! sha256sum --status -c <<<"$TLA_SHA256  $partial"; then
    rm -f "$partial"
    die "$TLA_URL does not match sha256 $TLA_SHA256"
  fi

  mv "$partial" "$JAR"
}

print_trace() {
  local log=$1

  awk -v spec="$SKILL/$SPEC" '
    function step(field) {
      sub(/:$/, ".", field)
      return field
    }
    BEGIN {
      while ((getline line < spec) > 0) {
        if (match(line, /^\\\* code: [^ ]+ [^ ]+ /)) {
          split(line, words, " ")
          pending = words[3] " " words[4]
        } else if (pending != "" && match(line, /^[A-Za-z]+(\([a-z]+\))? ==/)) {
          name = line
          sub(/(\([a-z]+\))? ==.*/, "", name)
          cited[name] = pending
          pending = ""
        }
      }
    }
    /^Error: (Invariant [A-Za-z0-9_]+ is violated|Temporal properties were violated)/ {
      sub(/^Error: /, "")
      print "  " $0
      next
    }
    /^Error: (The following behavior constitutes a counter-example|The behavior up to this point is):/ { tracing = 1; next }
    !tracing { next }
    /^State [0-9]+: <Initial predicate>/ { print "  1. initial state"; next }
    /^State [0-9]+: Stuttering/ { print "  " step($2) " nothing else ever happens"; exit }
    /^Back to state [0-9]+/ { print "  then the steps from state " $4 " repeat forever"; exit }
    /^State [0-9]+: </ {
      action = $3
      sub(/^</, "", action)
      sub(/\(.*$/, "", action)
      print "  " step($2) " " action "  (" cited[action] ")"
      next
    }
    /^\/\\ / { sub(/^\/\\ /, ""); print "       " $0; next }
    /^[0-9]+ states generated/ { exit }
  ' "$log"
}

run_model() {
  local cfg=$1 expect result log metadir status

  expect=$(sed -n 's/^\\\* expect: //p' "$SKILL/$cfg")
  [[ $expect == holds || $expect == violated ]] || die "$cfg has no '\\* expect: holds|violated' line"

  log=$LOGS/${cfg%.cfg}.log
  metadir=$(mktemp -d "$LOGS/states.XXXXXX")
  status=0
  (cd "$SKILL" && "$JAVA" -cp "$JAR" tlc2.TLC \
    -deadlock -difftrace -workers 1 -fp 0 -seed 1 -metadir "$metadir" -config "$cfg" "$SPEC") \
    >"$log" 2>&1 || status=$?
  rm -rf "$metadir"

  case $status in
    0) result=holds ;;
    12 | 13)
      if grep -q '^Error: Invariant TypeOK is violated' "$log"; then
        result="model error (TypeOK)"
      else
        result=violated
      fi
      ;;
    *) result="TLC error (exit $status)" ;;
  esac

  echo "$cfg: $result, expected $expect. Full TLC output: $log"
  [[ $result == violated || $result == "model error (TypeOK)" ]] && print_trace "$log"
  [[ $result == "TLC error (exit $status)" ]] && grep -E '^(Error|Encountered|Parse|\*\*\*)' "$log" | head -n 20

  [[ $result == "$expect" ]]
}

citations_only=0
unknown_option=

while [[ ${1:-} == -* ]]; do
  if [[ $1 == --citations ]]; then
    citations_only=1
  else
    unknown_option=$1
  fi
  shift
done

(($# >= 3)) && [[ -f $1/$2 ]] || die "usage: tlc-check [--citations] <skill-dir> <spec.tla> <config.cfg>..."

SKILL=$(cd "$1" && pwd)
SPEC=$2
shift 2
CONFIGS=("$@")
CHECKOUT=$(cd "$SKILL/../../.." && pwd)
CHECK=${SKILL#"$CHECKOUT"/}/scripts/check
LOGS=${TMPDIR:-/tmp}/$(basename "$SKILL")

[[ -z $unknown_option ]] || die "unknown option $unknown_option. usage: $CHECK [--citations]"

if ((citations_only)); then
  check_citations && exit 0
  echo "check: code that $SPEC models changed. Run $CHECK and follow its SKILL.md."
  exit 1
fi

command -v "$JAVA" >/dev/null || die "java is not on PATH; set JAVA to a Java 11 or newer binary"
mkdir -p "$LOGS"

if ! check_citations; then
  echo "check: FAILED before model checking, because the models no longer match the code. See SKILL.md, Read a failure."
  exit 1
fi

failed=0
fetch_tlc

for cfg in "${CONFIGS[@]}"; do
  run_model "$cfg" || failed=1
done

if ((failed)); then
  echo "check: FAILED. See SKILL.md, Read a failure."
  exit 1
fi

echo "check: every citation is current and every model matches its expected result."
