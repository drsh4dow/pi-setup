#!/usr/bin/env bash
set -euo pipefail

CHECKOUT=$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../.." && pwd)
SOCKET=verify-pi-setup
SCRATCH_BASE=${TMPDIR:-/tmp}/verify-pi-setup
EVIDENCE_BASE=$HOME/.local/state/pi-agent/verify-pi-setup
LIVE_AGENT_DIR=${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}
READY_PATTERN='[0-9.]+%/[0-9]'
POLL=0.25
# wait-idle's quiet period: 8 polls, 2 s at POLL.
IDLE_QUIET_POLLS=8

# "length" ends a turn only without a tool call: Pi fails a truncated call and asks again.
# "error" may be followed by a retry.
ENDS_TURN_JQ='def ends_turn: .role == "assistant"
  and (.stopReason == "stop" or .stopReason == "aborted"
    or (.stopReason == "length" and all(.content[]?; .type != "toolCall")));'

# Reads session lines past a send's baseline. Prints one line: "none" until the first user
# message, "ended" once an assistant message after it ends a turn, and otherwise "running",
# or "running: <last error>" after a failed request.
SEND_TURN_JQ="$ENDS_TURN_JQ"'
[inputs | fromjson? | select(.type == "message") | .message] as $messages
| ($messages | map(.role) | index("user")) as $prompt
| if $prompt == null then "none"
  else $messages[$prompt + 1:] as $after
  | if any($after[]; ends_turn) then "ended"
    else "running" + ([$after[] | .errorMessage // empty] | last | if . then ": " + (tostring | gsub("\n"; " ")) else "" end) end
  end'

# Reads a whole session file. Prints "idle" when its last conversation entry ends a turn,
# and otherwise what is running. A background job's result arrives as a custom_message.
SESSION_IDLE_JQ="$ENDS_TURN_JQ"'
[inputs | fromjson?
  | select(.type == "custom_message" or (.type == "message" and (.message.role | IN("user", "assistant", "toolResult"))))]
| last
| if . == null or (.type == "message" and (.message | ends_turn)) then "idle"
  elif .type == "custom_message" then "a turn is starting on a \(.customType) message"
  else "a turn is running (last message: \(.message.role) \(.message.stopReason // ""))" end'

usage() {
  cat <<'EOF'
control-pi launch [RUN_ID]          start an isolated Pi and wait for its footer (RUN_ID: A-Z a-z 0-9 _ -)
control-pi doctor RUN_ID            read-only health check of the instance
control-pi send RUN_ID TEXT         type TEXT literally, then press Enter
control-pi keys RUN_ID KEY...       send tmux key names (C-o, Escape, C-M-m, Down)
control-pi capture RUN_ID           print the visible pane
control-pi wait RUN_ID ERE [SECS]   wait until the pane matches ERE (default 60 s)
control-pi wait-turn RUN_ID [SECS]  wait until the turn of the last sent prompt ends
control-pi wait-idle RUN_ID [SECS]  wait until no turn, prompt, or background job is left
control-pi snap RUN_ID NAME         save the pane to EVIDENCE/NAME.txt
control-pi path RUN_ID scratch|evidence|agent|sessions
control-pi stop RUN_ID              tear down the instance and keep the evidence
control-pi list                     list runs that still have scratch state, and leftovers stop refuses
EOF
}

die() {
  echo "control-pi: $*" >&2
  exit 1
}

tm() {
  tmux -L "$SOCKET" "$@"
}

# tmux reads '.' and ':' in a target as separators, so a run id holds neither.
valid_run_id() {
  [[ $1 =~ ^[A-Za-z0-9_-]+$ ]]
}

bind_run() {
  RUN_ID=${1:-}
  [[ -n $RUN_ID ]] || die "missing RUN_ID"
  valid_run_id "$RUN_ID" ||
    die "invalid run id '$RUN_ID': use only letters, digits, '_' and '-'; tmux reads '.' and ':' in a target as separators"
  SCRATCH=$SCRATCH_BASE/$RUN_ID
  AGENT_DIR=$SCRATCH/agent
  EVIDENCE=$EVIDENCE_BASE/$RUN_ID
  SESSION=vps-$RUN_ID
  PANE="=$SESSION:"
  STDERR_LOG=$SCRATCH/pi.stderr.log
  SESSIONS=$SCRATCH/sessions
  SENDS=$SCRATCH/sends.jsonl
}

session_alive() {
  tm has-session -t "=$SESSION" 2>/dev/null &&
    [[ $(tm list-panes -t "$PANE" -F '#{pane_dead}') == 0 ]]
}

# Fails unless Pi is up, saying why. $1 names the wait for the "Pi exited" message.
require_up() {
  if [[ ! -d $SCRATCH ]]; then
    echo "control-pi: run $RUN_ID does not exist; launch it first" >&2
  elif ! tm has-session -t "=$SESSION" 2>/dev/null; then
    echo "control-pi: run $RUN_ID has scratch state but no tmux session: it is still launching, or its tmux session was killed; wait for 'control-pi launch' to print run=, or stop and relaunch it" >&2
  elif session_alive; then
    return 0
  else
    echo "control-pi: Pi exited${1:+ while waiting for $1}" >&2
    cat "$STDERR_LOG" >&2 2>/dev/null || true
  fi
  return 1
}

# Pi writes one .jsonl per session straight into $SESSIONS, and a new one after /new.
newest_session() {
  local file newest=
  for file in "$SESSIONS"/*.jsonl; do
    [[ -f $file && (-z $newest || $file -nt $newest) ]] && newest=$file
  done
  echo "$newest"
}

last_send() {
  tail -n 1 "$SENDS"
}

send_text() {
  jq -r .text <<<"$1"
}

# The turn of the prompt in send record $1, scanned from the session length it recorded, or
# from the start of a session file that is newer than the record.
send_turn() {
  local file offset
  file=$(newest_session)
  if [[ -z $file ]]; then
    echo none
    return
  fi
  offset=$(jq -r --arg file "$file" 'if .file == $file then .offset else 0 end' <<<"$1")
  tail -c +$((offset + 1)) "$file" | jq -nrR "$SEND_TURN_JQ"
}

pane() {
  tm capture-pane -p -J -t "$PANE" 2>/dev/null || true
}

pi_pid() {
  local shell_pid
  shell_pid=$(tm list-panes -t "$PANE" -F '#{pane_pid}' 2>/dev/null) || return 1
  pgrep -P "$shell_pid" -x pi | head -n 1
}

# One grep over every environ, so wait-idle can poll it.
pids_tagged_with_run() {
  pids_tagged_with "$RUN_ID"
}

pids_tagged_with() {
  { grep -lxFzs -- "VERIFY_PI_SETUP_RUN=$1" /proc/[0-9]*/environ || true; } | cut -d/ -f3
}

oauth_providers() {
  jq -r 'to_entries[] | select(.value.type == "oauth") | .key' "$1"
}

cmd_launch() {
  bind_run "${1:-$(date +%Y%m%dT%H%M%S)-$$}"
  [[ -e $SCRATCH ]] && die "run $RUN_ID already exists; stop it or pick another id"
  [[ -d $CHECKOUT/node_modules/effect ]] || die "run 'vp install' in $CHECKOUT first"
  [[ -x $CHECKOUT/.build/bin/emit-to-pi ]] || die "run 'vp run build:cli' in $CHECKOUT first"
  [[ -f $LIVE_AGENT_DIR/auth.json ]] || die "no credentials at $LIVE_AGENT_DIR/auth.json; run /login in Pi"

  # Refresh in the live directory, under Pi's own lock, so the scratch copy never needs to.
  local provider
  for provider in $(oauth_providers "$LIVE_AGENT_DIR/auth.json"); do
    PI_CODING_AGENT_DIR=$LIVE_AGENT_DIR pi auth print-bearer-token --provider "$provider" --min-expiry 30m >/dev/null ||
      echo "control-pi: warning: could not refresh $provider credentials" >&2
  done

  mkdir -p "$AGENT_DIR" "$SCRATCH/workspace" "$SESSIONS" "$EVIDENCE"
  trap 'launch_failed' EXIT
  echo "$CHECKOUT" >"$SCRATCH/checkout"
  install -m 600 "$LIVE_AGENT_DIR/auth.json" "$AGENT_DIR/auth.json"
  cp "$CHECKOUT/agent/SYSTEM.md" "$CHECKOUT/agent/keybindings.json" "$AGENT_DIR/"
  cp -R "$CHECKOUT/agent/skills" "$CHECKOUT/agent/prompts" "$CHECKOUT/agent/themes" "$AGENT_DIR/"
  # Extensions resolve imports from their own path, so they load in place from the checkout.
  jq --arg extensions "$CHECKOUT/agent/extensions" '. + {extensions: [$extensions]}' \
    "$CHECKOUT/agent/default.settings.json" >"$AGENT_DIR/settings.json"

  local unset_args=() name
  for name in $(compgen -e); do
    [[ $name == PI_* || $name == HERDR_* ]] && unset_args+=(-u "$name")
  done

  local command
  command=$(printf '%q ' env "${unset_args[@]}" \
    "VERIFY_PI_SETUP_RUN=$RUN_ID" \
    "PI_CODING_AGENT_DIR=$AGENT_DIR" \
    PI_SKIP_VERSION_CHECK=1 \
    HERDR_ENV=0 \
    pi --session-dir "$SESSIONS" --no-skills --skill "$AGENT_DIR/skills")
  tm new-session -d -s "$SESSION" -x 200 -y 50 -c "$SCRATCH/workspace" "$command 2>$(printf '%q' "$STDERR_LOG")"
  tm set-option -t "$PANE" remain-on-exit on >/dev/null

  wait_for "$READY_PATTERN" 60
  trap - EXIT

  echo "run=$RUN_ID"
  echo "scratch=$SCRATCH"
  echo "evidence=$EVIDENCE"
  echo "attach=tmux -L $SOCKET attach -t $SESSION"
}

launch_failed() {
  pane >"$EVIDENCE/launch-failure.pane.txt"
  cp "$STDERR_LOG" "$EVIDENCE/launch-failure.stderr.log" 2>/dev/null || true
  cmd_stop "$RUN_ID" >/dev/null
  echo "control-pi: launch failed; see $EVIDENCE/launch-failure.*" >&2
}

wait_for() {
  local pattern=$1 deadline=$((SECONDS + ${2:-60}))
  while ((SECONDS < deadline)); do
    require_up "/$pattern/" || return 1
    if pane | grep -qE -- "$pattern"; then
      return 0
    fi
    sleep "$POLL"
  done
  echo "control-pi: timed out waiting for /$pattern/" >&2
  pane >&2
  return 1
}

cmd_send() {
  bind_run "${1:-}"
  local text=${2:?text required} file offset=0
  require_up || exit 1
  # send records the baseline before it types the prompt, so nothing Pi writes for it lands before.
  file=$(newest_session)
  [[ -n $file ]] && offset=$(stat -c %s "$file")
  jq -cn --arg file "$file" --argjson offset "$offset" --arg text "$text" \
    '{file: $file, offset: $offset, text: $text}' >>"$SENDS"
  tm send-keys -t "$PANE" -l -- "$text"
  sleep 0.15
  tm send-keys -t "$PANE" Enter
}

cmd_wait_turn() {
  bind_run "${1:-}"
  local deadline=$((SECONDS + ${2:-60})) what="the turn of the last send to end" turn=none send
  require_up "$what" || exit 1
  [[ -s $SENDS ]] || die "no prompt sent to $RUN_ID since launch; run 'control-pi send' first"
  # The wait follows the send that is last now; a send made while it waits does not move it.
  send=$(last_send)
  while ((SECONDS < deadline)); do
    require_up "$what" || exit 1
    turn=$(send_turn "$send")
    [[ $turn == ended ]] && return 0
    sleep "$POLL"
  done
  case $turn in
  none) die "timed out: no turn started since the last send ($(send_text "$send")); wait-turn follows prompts, not keys or commands that start no turn" ;;
  "running: "*) die "timed out waiting for $what; last error: ${turn#running: }" ;;
  *) die "timed out waiting for $what" ;;
  esac
}

# Prints what keeps the run from being idle, or nothing when it is idle.
busy_reason() {
  local pi jobs file send
  pi=$(pi_pid || true)
  jobs=$(pids_tagged_with_run | grep -vx -- "${pi:-none}" || true)
  if [[ -n $jobs ]]; then
    # The name only: a process's arguments can hold a token.
    echo "background processes still run: $(ps -o pid=,comm= -p "${jobs//$'\n'/,}" 2>/dev/null | paste -sd ';' || true)"
  elif [[ -s $SENDS ]] && send=$(last_send) && [[ $(send_turn "$send") == none ]]; then
    echo "the last send has no user message in the session yet ($(send_text "$send"))"
  elif file=$(newest_session) && [[ -n $file ]]; then
    jq -nrR "$SESSION_IDLE_JQ" <"$file" | grep -vx idle || true
  fi
}

cmd_wait_idle() {
  bind_run "${1:-}"
  local deadline=$((SECONDS + ${2:-60})) what="the run to go idle" quiet=0 reason snapshot previous=
  require_up "$what" || exit 1
  while ((SECONDS < deadline)); do
    require_up "$what" || exit 1
    reason=$(busy_reason)
    snapshot=$(stat -c '%s %.9Y' "$(newest_session)" 2>/dev/null || true)
    if [[ -n $reason ]]; then
      quiet=0
    elif [[ $snapshot != "$previous" ]]; then
      quiet=0
      reason="the session file is still changing"
    elif ((++quiet >= IDLE_QUIET_POLLS)); then
      return 0
    fi
    previous=$snapshot
    sleep "$POLL"
  done
  die "timed out waiting for $what: $reason"
}

pi_env_has() {
  grep -qxz -- "$2" "/proc/$1/environ"
}

extensions_from_checkout() {
  [[ $(jq -r '.extensions[0]' "$AGENT_DIR/settings.json" 2>/dev/null) == "$CHECKOUT/agent/extensions" ]]
}

stderr_clean() {
  ! grep -qiE 'error|uncaught' "$STDERR_LOG" 2>/dev/null
}

footer_rendered() {
  pane | grep -qE -- "$READY_PATTERN"
}

cmd_doctor() {
  bind_run "${1:-}"
  local failures=0 pid

  check() {
    local description=$1
    shift
    if "$@"; then
      echo "ok    $description"
    else
      echo "FAIL  $description"
      failures=$((failures + 1))
    fi
  }

  check "scratch directory $SCRATCH exists" test -d "$AGENT_DIR"
  check "tmux session $SESSION is alive on socket $SOCKET" session_alive
  pid=$(pi_pid || true)
  check "pi process found (pid ${pid:-none})" test -n "$pid"
  if [[ -n $pid ]]; then
    check "pi uses the scratch agent directory, not the live one" pi_env_has "$pid" "PI_CODING_AGENT_DIR=$AGENT_DIR"
    check "pi reports nothing to Herdr" pi_env_has "$pid" HERDR_ENV=0
  fi
  check "extensions load from $CHECKOUT/agent/extensions" extensions_from_checkout
  check "stderr has no errors" stderr_clean
  check "footer is rendered" footer_rendered
  check "evidence directory $EVIDENCE exists" test -d "$EVIDENCE"

  echo "info  checkout $(git -C "$CHECKOUT" rev-parse --short HEAD)$(git -C "$CHECKOUT" diff --quiet HEAD -- agent || echo ' (agent/ has uncommitted changes)')"
  echo "info  $(pi --version 2>/dev/null | head -n 1)"
  local provider expires
  for provider in $(oauth_providers "$AGENT_DIR/auth.json" 2>/dev/null); do
    expires=$(jq -r --arg p "$provider" '.[$p].expires' "$AGENT_DIR/auth.json")
    echo "info  $provider credentials expire in $(((expires / 1000 - $(date +%s)) / 60)) min"
  done

  ((failures == 0))
}

cmd_stop() {
  bind_run "${1:-}"
  mkdir -p "$EVIDENCE"
  [[ -f $STDERR_LOG ]] && cp "$STDERR_LOG" "$EVIDENCE/pi.stderr.log"

  if [[ -f $AGENT_DIR/auth.json && -f $LIVE_AGENT_DIR/auth.json ]]; then
    local provider
    for provider in $(oauth_providers "$AGENT_DIR/auth.json"); do
      if ! jq -e --arg p "$provider" --slurpfile live "$LIVE_AGENT_DIR/auth.json" \
        '.[$p].refresh == $live[0][$p].refresh' "$AGENT_DIR/auth.json" >/dev/null; then
        echo "control-pi: warning: the run refreshed $provider credentials; if Pi later fails to refresh them, run /login" >&2
      fi
    done
  fi

  tm kill-session -t "=$SESSION" 2>/dev/null || true
  local -a pids
  for _ in 1 2 3 4 5 6 7 8; do
    mapfile -t pids < <(pids_tagged_with_run)
    ((${#pids[@]} == 0)) && break
    kill "${pids[@]}" 2>/dev/null || true
    sleep 0.25
  done
  mapfile -t pids < <(pids_tagged_with_run)
  if ((${#pids[@]} > 0)); then
    kill -9 "${pids[@]}" 2>/dev/null || true
  fi

  rm -rf "$SCRATCH"
  echo "stopped $RUN_ID; evidence kept in $EVIDENCE"
}

# Prints to stderr the commands that end the processes and the tmux session of a run id that
# bind_run refuses. tmux reads an exact session target that ends in ':' whole, dots included.
leftover_advice() {
  local id=$1 session=vps-$1 pids steps=()
  mapfile -t pids < <(pids_tagged_with "$id")
  ((${#pids[@]} > 0)) && steps+=("kill ${pids[*]}")
  tm has-session -t "=$session:" 2>/dev/null &&
    steps+=("tmux -L $SOCKET kill-session -t $(printf '%q' "=$session:")")
  ((${#steps[@]} > 0)) || return 0
  local joined
  joined=$(printf '; %s' "${steps[@]}")
  echo "control-pi: $id still holds its Pi or its tmux session; end them first with: ${joined#; }" >&2
}

cmd_list() {
  local dir name session
  local -A listed=()
  for dir in "$SCRATCH_BASE"/*/; do
    [[ -d $dir ]] || continue
    name=$(basename "$dir")
    if ! valid_run_id "$name"; then
      listed[$name]=1
      echo "$name invalid $SCRATCH_BASE/$name: stop refuses this id; remove the directory by hand"
      leftover_advice "$name"
      continue
    fi
    bind_run "$name"
    if session_alive; then
      echo "$RUN_ID alive  $(cat "$SCRATCH/checkout" 2>/dev/null)"
    else
      echo "$RUN_ID dead   $(cat "$SCRATCH/checkout" 2>/dev/null)"
    fi
  done
  while read -r session; do
    name=${session#vps-}
    [[ $session == vps-* ]] && ! valid_run_id "$name" && [[ -z ${listed[$name]:-} ]] || continue
    echo "$name invalid tmux session $session: stop refuses this id"
    leftover_advice "$name"
  done < <(tm list-sessions -F '#{session_name}' 2>/dev/null || true)
}

subcommand=${1:-}
shift || true
case $subcommand in
launch) cmd_launch "$@" ;;
doctor) cmd_doctor "$@" ;;
send) cmd_send "$@" ;;
keys)
  bind_run "${1:-}"
  shift
  require_up || exit 1
  tm send-keys -t "$PANE" "$@"
  ;;
capture)
  bind_run "${1:-}"
  pane
  ;;
wait)
  bind_run "${1:-}"
  wait_for "${2:?pattern required}" "${3:-60}"
  ;;
wait-turn) cmd_wait_turn "$@" ;;
wait-idle) cmd_wait_idle "$@" ;;
snap)
  bind_run "${1:-}"
  mkdir -p "$EVIDENCE"
  pane >"$EVIDENCE/${2:?name required}.txt"
  echo "$EVIDENCE/$2.txt"
  ;;
path)
  bind_run "${1:-}"
  case ${2:-} in
  scratch) echo "$SCRATCH" ;;
  evidence) echo "$EVIDENCE" ;;
  agent) echo "$AGENT_DIR" ;;
  sessions) echo "$SESSIONS" ;;
  *) die "path kind must be scratch, evidence, agent, or sessions" ;;
  esac
  ;;
stop) cmd_stop "$@" ;;
list) cmd_list ;;
*)
  usage
  [[ $subcommand == help || $subcommand == -h ]]
  ;;
esac
