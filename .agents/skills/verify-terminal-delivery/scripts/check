#!/usr/bin/env bash
set -euo pipefail

SKILL=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

exec "$SKILL/../../scripts/tlc-check" "$@" -- "$SKILL" TerminalDelivery.tla \
