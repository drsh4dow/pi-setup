{
  "lastChangelogVersion": "0.85.1",
  "packages": [
    "npm:pi-mcp-adapter"
  ],
  "defaultProvider": "openai-codex-cyber",
  "defaultModel": "gpt-6-astra",
  "enabledModels": [
    "openai-codex-cyber/gpt-daybreak-blue-latest",
    "openai-codex/gpt-6-astra",
    "openai-codex-cyber/gpt-6-astra"
  ],
  "delegate": {
    "model": "openai-codex-cyber/gpt-6-astra"
  },
  "defaultThinkingLevel": "high",
  "hideThinkingBlock": false,
  "treeFilterMode": "default",
  "theme": "catppuccin-mocha",
  "terminal": {
    "showTerminalProgress": false
  },
  "warnings": {
    "anthropicExtraUsage": false
  },
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 30000
  },
  "tuiMode": "fullscreen"
}