{
  "name": "pi-dotfiles",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch && node agent/scripts/sync-pi-patches.mjs",
    "typecheck": "tsc --noEmit",
    "check": "biome check agent/extensions agent/lib agent/scripts",
    "check:fix": "biome check agent/extensions agent/lib agent/scripts --write",
    "test:delegate": "node --test agent/extensions/delegate/test/*.test.ts",
    "test:background-terminals": "node --test agent/extensions/background-terminals/test/*.test.ts",
    "test:process-status": "node --test agent/extensions/process-status/test/*.test.ts",
    "test:runtime-patches": "node --test agent/lib/test/*.test.ts",
    "test:compaction": "node --test agent/extensions/compaction/test/*.test.ts",
    "test:aoauth": "node --test agent/extensions/aoauth/test/*.test.ts",
    "test:codex-accounts": "node --test agent/extensions/codex-accounts/test/*.test.ts",
    "test:skill-visibility": "node --test agent/extensions/skill-visibility/test/*.test.ts",
    "test:gpt-fast-mode": "node --test agent/extensions/gpt-fast-mode/test/*.test.ts",
    "test:sacrifice-preference": "node --test agent/extensions/sacrifice-preference/test/*.test.ts",
    "test:extensions": "node --test $(find agent/extensions -path '*/test/*.test.ts' ! -name 'e2e.test.ts' -print | sort)",
    "test:docs": "node --test agent/scripts/test/*.test.mjs && node agent/scripts/verify-docs.mjs",
    "test:e2e": "PI_E2E=1 node --test --test-concurrency=1 --test-timeout=900000 agent/extensions/*/test/e2e.test.ts",
    "verify": "bun run typecheck && bun run check && bun run test:extensions && bun run test:runtime-patches && bun run test:docs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.84.2",
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@earendil-works/pi-tui": "^0.84.2",
    "@effect/platform-bun": "4.0.0-rc.110",
    "effect": "4.0.0-rc.110"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@effect/tsgo": "0.36.5",
    "@types/node": "^26.2.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  },
  "trustedDependencies": [
    "@google/genai",
    "protobufjs"
  ],
  "patchedDependencies": {
    "@earendil-works/pi-coding-agent@0.84.2": "patches/@earendil-works%2Fpi-coding-agent@0.84.2.patch"
  }
}
