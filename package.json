{
  "name": "pi-dotfiles",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch",
    "typecheck": "tsc --noEmit",
    "check": "biome check agent/extensions agent/lib",
    "check:fix": "biome check agent/extensions agent/lib --write",
    "test:delegate": "node --test agent/extensions/delegate/test/*.test.ts",
    "test:background-terminals": "node --test agent/extensions/background-terminals/test/*.test.ts",
    "test:process-status": "node --test agent/extensions/process-status/test/*.test.ts",
    "test:compaction": "node --test agent/extensions/compaction/test/*.test.ts",
    "test:aoauth": "node --test agent/extensions/aoauth/test/*.test.ts",
    "test:skill-visibility": "node --test agent/extensions/skill-visibility/test/*.test.ts",
    "test:web-access": "node --test agent/extensions/web-access/test/*.test.ts",
    "test:gpt-fast-mode": "node --test agent/extensions/gpt-fast-mode/test/*.test.ts",
    "test:e2e": "PI_E2E=1 node --test --test-concurrency=1 --test-timeout=900000 agent/extensions/*/test/e2e.test.ts",
    "verify": "bun run typecheck && bun run check && bun run test:delegate && bun run test:background-terminals && bun run test:process-status && bun run test:compaction && bun run test:aoauth && bun run test:skill-visibility && bun run test:web-access && bun run test:gpt-fast-mode"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.83.0",
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@earendil-works/pi-tui": "^0.83.0",
    "@effect/platform-bun": "4.0.0-beta.102",
    "effect": "4.0.0-beta.102"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@effect/tsgo": "0.26.7",
    "@types/node": "^26.1.2",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  },
  "trustedDependencies": [
    "@google/genai",
    "protobufjs"
  ],
  "patchedDependencies": {
    "@earendil-works/pi-coding-agent@0.83.0": "patches/@earendil-works%2Fpi-coding-agent@0.83.0.patch"
  }
}
