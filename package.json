{
  "name": "pi-dotfiles",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch && node agent/scripts/patch-pi-output-guard.mjs",
    "typecheck": "tsc --noEmit",
    "check": "biome check agent/extensions agent/lib agent/scripts",
    "check:fix": "biome check agent/extensions agent/lib agent/scripts --write",
    "test:delegate": "node --test agent/extensions/delegate/test/*.test.ts",
    "test:background-terminals": "node --test agent/extensions/background-terminals/test/*.test.ts",
    "test:process-status": "node --test agent/extensions/process-status/test/*.test.ts",
    "test:output-guard": "node --test agent/extensions/test/output-guard.test.ts",
    "test:skill-visibility": "node --test agent/extensions/skill-visibility/test/*.test.ts",
    "test:web-access": "node --test agent/extensions/web-access/test/*.test.ts",
    "test:e2e": "PI_E2E=1 node --test --test-concurrency=1 --test-timeout=900000 agent/extensions/*/test/e2e.test.ts",
    "verify": "bun run typecheck && bun run check && bun run test:delegate && bun run test:background-terminals && bun run test:process-status && bun run test:output-guard && bun run test:skill-visibility && bun run test:web-access"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.80.6",
    "@earendil-works/pi-coding-agent": "^0.80.6",
    "@earendil-works/pi-tui": "^0.80.6",
    "effect": "4.0.0-beta.98"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@effect/tsgo": "0.22.0",
    "@types/node": "^26.1.1",
    "prettier": "^3.9.5",
    "typescript": "^7.0.2"
  },
  "trustedDependencies": [
    "@google/genai",
    "protobufjs"
  ]
}
