+import { existsSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { getAgentDir } from "../config.js";
+export function formatStorageQuotaError(error) {
+    let current = error;
+    for (let depth = 0; depth < 5 && current && typeof current === "object"; depth++) {
+        const code = "code" in current ? current.code : undefined;
+        const errno = "errno" in current ? current.errno : undefined;
+        if (code === "EDQUOT" || errno === -122) {
+            const errnoDetail = typeof errno === "number" ? `; errno ${errno}` : "";
+            return `Storage quota exceeded while writing data (EDQUOT${errnoDetail}). Free space or raise the per-user quota on the affected filesystem. If this was temporary output, clear stale files under ${tmpdir()} or set TMPDIR to a filesystem with available quota, then retry.`;
+        }
+        current = "cause" in current ? current.cause : undefined;
+    }
+    return undefined;
+}
+function formatBytes(bytes) {
+    if (bytes < 1024)
+        return `${bytes} B`;
+    const units = ["KiB", "MiB", "GiB", "TiB"];
+    let value = bytes;
+    let unit = -1;
+    do {
+        value /= 1024;
+        unit++;
+    } while (value >= 1024 && unit < units.length - 1);
+    return `${value.toFixed(value >= 10 ? 1 : 2)} ${units[unit]}`;
+}
+export function recoverStorageQuota(error, options) {
+    if (!formatStorageQuotaError(error))
+        return undefined;
+    const script = join(getAgentDir(), "scripts", "recover-temp-space.mjs");
+    if (!existsSync(script))
+        return `Automatic temporary-space recovery is unavailable because ${script} is missing.`;
+    const recovery = spawnSync(process.execPath, [script, JSON.stringify({
+            directory: options.directory ?? tmpdir(),
+            requiredBytes: options.requiredBytes,
+            protectedPaths: options.protectedPaths ?? [],
+        })], {
+        encoding: "utf8",
+        maxBuffer: 1024 * 1024,
+        timeout: 120_000,
+    });
+    if (recovery.error)
+        return `Automatic temporary-space recovery failed: ${recovery.error.message}`;
+    if (recovery.status !== 0)
+        return `Automatic temporary-space recovery failed: ${recovery.stderr.trim().slice(0, 500) || `exit code ${recovery.status}`}`;
+    let result;
+    try {
+        result = JSON.parse(recovery.stdout);
+    }
+    catch {
+        return "Automatic temporary-space recovery returned an invalid result.";
+    }
+    if (!result.supported)
+        return `Automatic temporary-space recovery is unavailable: ${result.reason ?? "unsupported platform"}.`;
+    const summary = `Automatic cleanup deleted ${result.deletedCount} oldest temporary ${result.deletedCount === 1 ? "entry" : "entries"} and freed ${formatBytes(result.freedBytes)}.`;
+    if (result.enough) {
+        const escalation = result.escalated ? " Cleanup escalated beyond disposable Pi artifacts as configured." : "";
+        return `${summary}${escalation} The new-output allowance and 30% safety reserve are available; retry the command to regenerate its full output.`;
+    }
+    return `${summary} It could not free the required ${formatBytes(result.targetBytes)}. Pi remains running; choose another TMPDIR or clear more space before retrying.`;
